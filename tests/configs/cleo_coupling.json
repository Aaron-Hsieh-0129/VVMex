{
    "__doc": "Template for the CLEO coupling tests. tests/scripts/make_cleo_test_case.py applies one entry of test_scenarios, points every path into the test's build directory and runs tools/cleo/gen_cleo_inputs.py on the result. test_cleo_interface reads this file as it is: the constructor touches no CLEO input.",
    "grid": {
        "nx": 4,
        "ny": 2,
        "nz": 8,
        "n_halo_cells": 2,
        "dx": 100.0,
        "dy": 100.0,
        "dz": 100.0,
        "dz1": 100.0
    },
    "simulation": {
        "dt_s": 1.0,
        "total_time_s": 10.0,
        "output_interval_s": 3.0
    },
    "dynamics": {
        "solver": {
            "w_solver_method": "tridiagonal",
            "iteration": 1,
            "WRXMU": 2.5e-07
        }
    },
    "output": {
        "output_dir": "./build/testing_output_cleo_coupling/"
    },
    "physics": {
        "p3": {
            "enable_p3": false
        },
        "turbulence": {
            "enable_turbulence": false
        },
        "rrtmgp": {
            "enable_rrtmgp": false
        },
        "microphysics": {
            "engine": "cleo",
            "aerosol": {
                "geometric_mean_radius_m": [
                    2e-08,
                    1.5e-07
                ],
                "geometric_stddev": [
                    1.4,
                    1.6
                ],
                "number_conc_per_m3": [
                    60000000.0,
                    40000000.0
                ]
            },
            "cleo": {
                "init_gbx_path": "./build/testing_output_cleo_coupling/share/dimlessGBxboundaries.dat",
                "init_supers_path": "./build/testing_output_cleo_coupling/share/dimlessSDsinit.dat",
                "average_over_y": false,
                "timesteps_s": {
                    "condensation": 0.1,
                    "collision": 0.1,
                    "motion": 0.1,
                    "observation": 1.0,
                    "coupling": 1.0
                },
                "superdroplets": {
                    "per_gridbox": 16,
                    "seed_below_z_m": null,
                    "radius_min_m": 1e-08,
                    "radius_max_m": 4e-07,
                    "numconc_tolerance": 0.05,
                    "common_multiplicity": false,
                    "wet_scale": 2.0,
                    "__haze": "radius_min_m/radius_max_m are DRY radii; the wet radius is dry * wet_scale. Every superdroplet must stay below diagnostics.cloud_min_radius_um (1 um) so the scenarios start with haze only, and wet_scale > 1 gives the haze water, so qp > 0.",
                    "seed": 20261002
                },
                "diagnostics": {
                    "cloud_min_radius_um": 1.0,
                    "rain_min_radius_um": 40.0
                },
                "process": {
                    "enable_condensation": true,
                    "enable_collision": false,
                    "collision_seed": 0,
                    "condensation": {
                        "do_alter_thermo": true,
                        "maxniters": 100,
                        "MINSUBTSTEP": 1e-05,
                        "rtol": 0.0,
                        "atol": 0.01
                    },
                    "breakup_nfrags": 5.0
                },
                "output": {
                    "zarrbasedir": "cleo.zarr"
                }
            }
        }
    },
    "constants": {
        "gravity": 9.806,
        "Rd": 287.04,
        "P0": 100000.0,
        "Cp": 1004.5,
        "Lv": 2500000.0
    },
    "test_cleo": {
        "__doc": "Read by test_cleo_coupling only, never by the model: the uniform wind of the advection scenario.",
        "u_m_s": 0.0,
        "v_m_s": 0.0
    },
    "test_scenarios": {
        "__doc": "Dotted-key overrides of the configuration above, one set per scenario of test_cleo_coupling.",
        "transport": {
            "physics.microphysics.cleo.process.enable_condensation": false,
            "physics.microphysics.cleo.process.enable_collision": false
        },
        "condensation": {
            "physics.microphysics.cleo.process.enable_condensation": true,
            "physics.microphysics.cleo.process.enable_collision": false,
            "physics.microphysics.cleo.timesteps_s.coupling": 2.0
        },
        "average_y": {
            "physics.microphysics.cleo.process.enable_condensation": true,
            "physics.microphysics.cleo.process.enable_collision": false,
            "physics.microphysics.cleo.average_over_y": true
        },
        "rain": {
            "physics.microphysics.cleo.process.enable_condensation": false,
            "physics.microphysics.cleo.process.enable_collision": false,
            "physics.microphysics.cleo.superdroplets.seed_below_z_m": 100.0,
            "physics.microphysics.cleo.superdroplets.radius_min_m": 3e-07,
            "physics.microphysics.cleo.superdroplets.radius_max_m": 1e-06,
            "physics.microphysics.cleo.superdroplets.wet_scale": 1000.0,
            "physics.microphysics.cleo.superdroplets.numconc_tolerance": 0.1,
            "physics.microphysics.aerosol.geometric_mean_radius_m": [
                5e-07
            ],
            "physics.microphysics.aerosol.geometric_stddev": [
                1.3
            ],
            "physics.microphysics.aerosol.number_conc_per_m3": [
                1000.0
            ],
            "simulation.output_interval_s": 3.0
        },
        "rain_collision": {
            "physics.microphysics.cleo.process.enable_condensation": false,
            "physics.microphysics.cleo.process.enable_collision": true,
            "physics.microphysics.cleo.superdroplets.seed_below_z_m": 100.0,
            "physics.microphysics.cleo.superdroplets.radius_min_m": 3e-07,
            "physics.microphysics.cleo.superdroplets.radius_max_m": 1e-06,
            "physics.microphysics.cleo.superdroplets.wet_scale": 1000.0,
            "physics.microphysics.cleo.superdroplets.numconc_tolerance": 0.1,
            "physics.microphysics.aerosol.geometric_mean_radius_m": [
                5e-07
            ],
            "physics.microphysics.aerosol.geometric_stddev": [
                1.3
            ],
            "physics.microphysics.aerosol.number_conc_per_m3": [
                1000.0
            ],
            "simulation.output_interval_s": 3.0,
            "physics.microphysics.cleo.process.collision_seed": 1234
        },
        "advection": {
            "__doc": "u dt is 0.8 of a gridbox, and in 25 s every superdroplet crosses the whole x domain (and so every rank boundary of a 2 x 2 split) at least once.",
            "grid.nx": 16,
            "grid.ny": 16,
            "grid.dx": 50.0,
            "grid.dy": 50.0,
            "simulation.total_time_s": 25.0,
            "physics.microphysics.cleo.superdroplets.per_gridbox": 8,
            "physics.microphysics.cleo.process.enable_condensation": false,
            "physics.microphysics.cleo.process.enable_collision": false,
            "test_cleo.u_m_s": 40.0,
            "test_cleo.v_m_s": -30.0
        },
        "average_y_split": {
            "grid.nx": 4,
            "grid.ny": 4,
            "physics.microphysics.cleo.average_over_y": true
        }
    }
}
