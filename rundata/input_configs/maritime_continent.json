  "constants": {
    "gravity": 9.806,
    "Rd": 287.04,
    "PSFC": 100000,
    "P0": 100000,
    "Cp": 1004.5,
    "Lv": 2500000.0,
    "OMEGA": 7.292e-05,
    "PI": 3.14159265
