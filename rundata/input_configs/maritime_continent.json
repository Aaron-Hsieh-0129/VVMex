{
  "__description": "Maritime Continent case based on tropical_band.json, using rll_mc_only.nc spatial initial data and the Noah land surface model. Validated for 130 simulated seconds at full resolution on 8 H100 GPUs with P3 column chunking.",
  "grid": {
    "horizontal": {
      "nx": 6144,
      "ny": 1536,
      "n_halo_cells": 2,
      "geometry": {
        "kind": "regular_latlon",
        "earth_radius_m": 6371220,
        "longitude_bounds_deg": [
          -180.0,
          180.0
        ],
        "latitude_bounds_deg": [
          -45.0,
          45.0
        ]
      },
      "topology": {
        "q1": "periodic",
        "q2": "bounded"
      }
    },
    "vertical": {
      "nz": 44,
      "type": "default",
      "dz": 500.0,
      "dz1": 500.0
    }
  },
  "simulation": {
    "total_time_s": 8640000.0,
    "dt_s": 5.0,
    "output_interval_s": 3600.0,
    "idealized_test": "rll_mountain"
  },
  "initial_conditions": {
    "format": "txt",
    "source_file": "./rundata/initial_conditions/profiles/GATE.txt",
    "constant_upper_wind": {
      "enable": false,
      "pressure_threshold_Pa": 25000.0
    },
    "perturbation": "none",
    "barotropic_jet": {
      "case": 1,
      "jet_scale": 0,
      "perturbation_scale": 0
    },
    "rll_mountain": {
      "terrain_source": "netcdf",
      "zonal_flow": true,
      "u0_m_s": 0
    }
  },
  "netcdf_reader": {
    "source_file": "./rundata/initial_conditions/spatial/rll_mc_only.nc",
    "Tg_source": "netcdf",
    "__Tg_source_options": "atmosphere, netcdf",
    "variables_to_read": {
      "2d": [
        "topo",
        "sea_land_ice_mask",
        "vegtype",
        "soiltype",
        "slopetype",
        "Tg",
        "albedo",
        "gvf",
        "lai",
        "shdmax",
        "shdmin"
      ]
    }
  },
  "dynamics": {
    "solver": {
      "w_solver_method": "tridiagonal",
      "iteration": 100,
      "initial_iterations": 1000,
      "vertical_iterations": 10,
      "WRXMU": 2255135.7938,
      "__WRXMU": "RLL angular relaxation shift = 2/(4000 m / earth_radius_m)^2."
    },
    "forcings": {
      "sponge_layer": {
        "enable": true,
        "damp_thermo": false,
        "damp_vort": true,
        "sponge_layer_base": 18000.0,
        "inv_CRAD": 3600.0
      },
      "random_perturbation": {
        "enable": true,
        "time_s": 200,
        "amplitude": 0.5,
        "z_start_m": 0,
        "z_end_m": 2000,
        "random_seed": 1129
      },
      "lateral_boundary_nudging": {
        "enable": false,
        "boundaries": {
          "west": true,
          "east": true,
          "south": false,
          "north": false
        },
        "tau_b": 300.0,
        "offset": 14000.0,
        "width": 4000.0,
        "radius": 4000.0,
        "target_vars": [
          "qv"
        ],
        "forcing_data": {
          "time_varying": false,
          "directory": "../rundata/LS_forcings/",
          "file_name_for_not_varying": "ls_forcing_constant.nc",
          "file_prefix": "ls_forcing_",
          "update_interval_s": 3600.0
        }
      },
      "areamn": {
        "enable": false,
        "uvtau": 7200,
        "nudge_start_m": 0
      }
    },
    "prognostic_variables": {
      "th": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "xi": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "buoyancy": {
            "enable": true,
            "temporal_scheme": "ForwardEuler",
            "spatial_scheme": "Takacs"
          },
          "stretching": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "twisting": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "coriolis": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "eta": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "buoyancy": {
            "enable": true,
            "temporal_scheme": "ForwardEuler",
            "spatial_scheme": "Takacs"
          },
          "stretching": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "twisting": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "coriolis": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "zeta": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "stretching": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "twisting": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          },
          "coriolis": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "qv": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "qc": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "qr": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "qi": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "qm": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "nc": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "nr": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "ni": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      },
      "bm": {
        "tendency_terms": {
          "advection": {
            "enable": true,
            "temporal_scheme": "AdamsBashforth2",
            "spatial_scheme": "Takacs"
          }
        }
      }
    }
  },
  "physics": {
    "p3": {
      "enable_p3": true,
      "column_chunk_size": 16384,
      "__column_chunk_size": "Maximum P3 columns processed at once per compute rank; reuses work buffers to fit this case on 8 H100 GPUs.",
      "make_lookup_table": false,
      "do_predict_nc": true,
      "do_prescribed_ccn": false,
      "max_total_ni": 740000.0
    },
    "rrtmgp": {
      "enable_rrtmgp": true,
      "column_chunk_size": 256,
      "__column_chunk_size": "This should be modified according to domain and rank and the larger the faster (costs more memory).",
      "rad_frequency_s": 120,
      "active_gases": [
        "h2o",
        "co2",
        "o3",
        "n2o",
        "co",
        "ch4",
        "o2",
        "n2"
      ],
      "fixed_total_solar_irradiance": 551.58,
      "fixed_solar_zenith_angle": 0.74256,
      "pool_size_multiplier": 1.0,
      "time": {
        "year": 2021,
        "month": 3,
        "day": 31,
        "hour": 16,
        "minute": 0,
        "second": 0
      }
    },
    "turbulence": {
      "enable_turbulence": true
    },
    "surface_process": {
      "enable": true,
      "frequency_s": 120,
      "land_scheme": "noahlsm",
      "__land_scheme_options": "none, noahlsm",
      "ocean_scheme": "sflux_2d",
      "__ocean_scheme_options": "none, sflux_2d, sflux_tc_2d, tco_ocean",
      "__mode_explaination1": "If noahlsm is turned on, it will call Fortran land model (src/physics/land) with ocean/land/ice model inside.",
      "__mode_explaination2": "However, by changing ocean_scheme options to sflux_2d or sflux_tc_2d, it uses the C++ surface flux (original VVM surface flux, src/physics/surface) and the ocean model in LandProcess will be turned off."
    }
  },
  "output": {
    "engine": "SST",
    "queue_limit": 20,
    "data_transport": "UCX",
    "control_transport": "TCP",
    "output_dir": "./output/rll_mc_only",
    "output_filename_prefix": "rll_mc_only",
    "output_initial_step": true,
    "bp5": {
      "aggregation_type": "TwoLevelShm",
      "num_subfiles": 8,
      "stats_level": 0,
      "async_write": true,
      "buffer_mode": "pack",
      "overwrite": true
    },
    "fields_to_output": [
      "thbar",
      "pibar",
      "rhobar",
      "rhobar_up",
      "u",
